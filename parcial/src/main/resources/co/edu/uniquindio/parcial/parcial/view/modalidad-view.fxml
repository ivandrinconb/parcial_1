<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="702.0" prefWidth="671.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.parcial.parcial.controller.ModalidadController">
    <top>
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Registro de Modalidades de Alquiler">
            <BorderPane.margin><Insets bottom="10" left="10" top="10" /></BorderPane.margin>
        </Label>
    </top>
    <left>
        <VBox prefWidth="280" spacing="10">
            <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>

            <Label text="Código:" />
            <TextField fx:id="txtCodigo" />

            <Label text="Nombre:" />
            <ComboBox fx:id="cbNombre" prefWidth="200" promptText="Selecciona modalidad" />

            <Label text="Descripción:" />
            <TextField fx:id="txtDescripcion" />

            <Label text="Duración mínima (días):" />
            <TextField fx:id="txtDuracionMinima" />

            <Label text="Valor diario:" />
            <TextField fx:id="txtValorDiario" />

            <Label text="Estado:" />
            <ComboBox fx:id="cbEstado" prefWidth="200" promptText="Selecciona estado" />

            <Label text="Cobertura (Premium):" />
            <TextField fx:id="txtCobertura" />

            <Label text="Conductores adicionales (Premium):" />
            <TextField fx:id="txtConductores" />

            <Label text="Características especiales (Premium):" />
            <TextField fx:id="txtCaracteristicas" />

            <Button onAction="#registrarModalidad" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Registrar" />
            <Label fx:id="lblMensaje" style="-fx-text-fill: red;" wrapText="true" />
        </VBox>
    </left>
    <center>
        <TableView fx:id="tablaModalidades" style="-fx-text-fill: black;" prefHeight="630.0" prefWidth="636.0">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="80" text="Código" style="-fx-text-fill: black;" />
                <TableColumn fx:id="colNombre" prefWidth="100" text="Nombre" />
                <TableColumn fx:id="colDescripcion" prefWidth="208.0" text="Descripción" />
                <TableColumn fx:id="colDuracion" prefWidth="154.4000244140625" text="Duración mínima" />
                <TableColumn fx:id="colValor" prefWidth="184.79998779296875" text="Valor diario" />
                <TableColumn fx:id="colEstado" prefWidth="214.4000244140625" text="Estado" />
            </columns>
            <BorderPane.margin><Insets bottom="10" right="10" top="10" /></BorderPane.margin>
        </TableView>
    </center>
</BorderPane>
